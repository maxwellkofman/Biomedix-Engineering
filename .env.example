# Optional: Microsoft Entra ID app registration for "Create it in SharePoint".
# Single-page application, redirect URI https://<your-host>/redirect.html,
# Microsoft Graph delegated permissions Sites.Manage.All and Sites.ReadWrite.All.
VITE_M365_CLIENT_ID=
# Tenant ID or domain; leave empty to allow any work account.
VITE_M365_TENANT=
